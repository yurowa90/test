# Supabase 프로젝트 설정 (Supabase 대시보드 → Project Settings → API)
# 이 파일을 .env.local로 복사한 뒤 실제 값을 채우세요. .env* 파일은 커밋되지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 주의:
# - service role key는 이 앱(Next.js)에 절대 두지 않습니다. Edge Function 전용입니다.
# - Gemini API Key는 환경 변수로 관리하지 않습니다 (교사 BYOK — SECURITY_MODEL.md 참고).
